{
  "name": "hotel-offer-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Hotel offer comparison with Temporal orchestration and Redis price filtering",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/build-workflows.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:infra": "node --env-file-if-exists=.env tests/infrastructure.mjs",
    "test:hotels": "node --env-file-if-exists=.env tests/hotels-integration.mjs",
    "test:reliability": "node tests/reliability.mjs",
    "validate:postman": "node scripts/validate-postman.mjs",
    "test:postman": "npm run validate:postman && newman run postman/hotel-offer-orchestrator.postman_collection.json --timeout-request 40000"
  },
  "dependencies": {
    "@temporalio/activity": "1.26.0",
    "@temporalio/client": "1.26.0",
    "@temporalio/worker": "1.26.0",
    "@temporalio/workflow": "1.26.0",
    "express": "5.3.0",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "ajv": "6.15.0",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "newman": "6.2.3",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
