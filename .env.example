PORT=4000
NODE_ENV=development
LOG_LEVEL=info
APP_MODE=api
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
TEMPORAL_CLI_PATH=temporal
REDIS_URL=redis://127.0.0.1:6379
ENABLE_INFRA_PROBE=false
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false
# Optional full endpoint URLs; defaults use loopback and PORT.
# SUPPLIER_A_URL=http://127.0.0.1:4000/supplierA/hotels
# SUPPLIER_B_URL=http://127.0.0.1:4000/supplierB/hotels
# Optional hostname for the EC2 HTTPS Compose overlay.
# PUBLIC_HOSTNAME=hotelapi.nishantraj.me
